APP_NAME="Audit Deevatech"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://audit.deevatech.my.id

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Port nginx di host, hanya bind ke 127.0.0.1 (8083 sudah dipakai BMS)
APP_PORT=8084

# uid/gid user VPS — isi dengan hasil `id -u` / `id -g`
HOST_UID=1000
HOST_GID=1000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# DB_HOST = nama service di docker-compose, JANGAN 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=audit_gmp
DB_USERNAME=audit_user
DB_PASSWORD=GANTI_PASSWORD_KUAT
DB_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=audit.deevatech.my.id
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# App tidak memakai queued job & tidak ada container worker
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=audit

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@deevatech.my.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_ADMIN_NUMBER=6285172347665
